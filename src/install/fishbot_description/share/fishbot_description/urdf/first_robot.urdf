<?xml version="1.0"?>
<robot name="first_robot">
    <!--机器人的身体部分-->
    <link name="base_link">
        <!--部件的外观描述-->
        <visual>
            <!--原点方向，沿着自己几何中心的偏移和旋转量-->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

            <!--部件的几何形状-->
            <geometry>
                <!--圆柱体-->
                <cylinder radius="0.10" length="0.12"/>
            </geometry>

            <!--部件的材质-->
            <material name="white">
                <!--rgb颜色 a透明程度：1完全不透明-->
                <color rgba="1.0 1.0 1.0 0.5"/>
            </material>

        </visual>
    </link>

    <!-- 机器人的IMU部件，惯性测量传感器-->
     <link name="imu_link">
        <!--部件的外观描述-->
        <visual>
            <!--原点方向，沿着自己几何中心的偏移和旋转量-->
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>

            <!--部件的几何形状-->
            <geometry>
                <!--正方体-->
                <box size="0.02 0.02 0.02"/>
            </geometry>

            <!--部件的材质-->
            <material name="black">
                <!--rgb颜色 a透明程度：1完全不透明-->
                <color rgba="0.0 0.0 0.0 0.5"/>
            </material>

        </visual>
    </link>

    <!-- 机器人的关节：用于组合机器人的部件-->
    <!--type:说明关节是可移动还是固定的 -->
    <joint name="imu_joint" type="fixed">
        <!--父部件-->
        <parent link="base_link"/>
        <!--子部件-->
        <child link="imu_link"/>
        <!--固定位置-->
        <origin xyz="0.0 0.0 0.03" rpy="0.0 0.0 0.0"/>
        
    </joint>
</robot>